PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
WALLET_PROVIDER_TIMEOUT_MS=8000

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=localstack
AWS_SECRET_ACCESS_KEY=localstack
AWS_ENDPOINT_URL=http://localstack.lvh.me:4566
WALLET_DOCUMENTS_TABLE=wallet-documents
WALLET_ARTIFACTS_BUCKET=wallet-artifacts

# P5 Google Wallet (Save-to-Wallet JWT). Leave blank to keep provider.status FAILED.
GOOGLE_WALLET_SA_EMAIL=
GOOGLE_WALLET_SA_PRIVATE_KEY=
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_ORIGINS=http://localhost:3000
GOOGLE_WALLET_LOGO_URL=

# P6 Apple Wallet (.pkpass). These are the only Apple settings.
# Values may come from the process environment or this local .env file.
# Certificate/key values accept inline PEM or filesystem paths.
# Leave blank to keep provider.status FAILED.
# APPLE_WWDR_CERTIFICATE must be the WWDR G4 intermediate (not the Apple Root CA).
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERTIFICATE=
APPLE_PASS_KEY=
APPLE_WWDR_CERTIFICATE=
